{
  "name": "@lego/mobile-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "./src/entry/styles.ts"
  ],
  "main": "./src/index.ts",
  "module": "./src/index.ts",
