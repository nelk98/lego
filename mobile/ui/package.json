      "import": "./src/icon/index.tsx"
    }
  },
  "dependencies": {
    "@lego/shared": "workspace:*",
    "@tarojs/components": "4.1.11",
    "@tarojs/taro": "4.1.11"
  },
  "devDependencies": {
    "typescript": "~5.9.3"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  }
}
