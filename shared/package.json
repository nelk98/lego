{
  "name": "@lego/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "./src/icon/style.css",
    "./src/style/**/*.scss",
    "./src/ui/**/*.scss"
  ],
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts"
    },
    "./theme": {
      "types": "./src/theme/index.ts",
      "import": "./src/theme/index.ts",
      "require": "./src/theme/index.ts"
    },
    "./style-tokens": {
      "types": "./src/style/palette.meta.ts",
      "import": "./src/style/palette.meta.ts",
      "require": "./src/style/palette.meta.ts"
    },
    "./icon": {
      "types": "./src/icon/index.ts",
      "import": "./src/icon/index.ts",
      "require": "./src/icon/index.ts"
    },
    "./icon/style.css": "./src/icon/style.css",
    "./palette": "./src/style/palette.scss",
    "./web": "./src/style/web.scss",
    "./mobile": "./src/style/mobile.scss",
    "./variables": "./src/style/variables.scss",
    "./styles/web": "./src/style/web.scss",
    "./styles/mobile": "./src/style/mobile.scss",
    "./styles/variables": "./src/style/variables.scss",
    "./icon/types": {
      "types": "./src/icon/types.ts",
      "import": "./src/icon/types.ts",
      "default": "./src/icon/types.ts"
    }
  },
  "peerDependencies": {
    "pinia": "^3.0.0",
    "vue": "^3.5.0"
  }
}
