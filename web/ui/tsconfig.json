{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@/shadcn/utils": ["./src/shadcn/utils.ts"],
      "@/shadcn/*": ["./src/shadcn/*"],
      "@/components/*": ["./src/components/*"],
      "@/composables/*": ["./src/composables/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.vue"]
}
